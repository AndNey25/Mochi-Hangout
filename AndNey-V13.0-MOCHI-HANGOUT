-- 3. NORMALIZED LOGIC
local function startFishing()
    task.spawn(function()
        while _G.AutoFish do
            pcall(function()
                local char = player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                
                local hrp = char.HumanoidRootPart
                local pos = hrp.Position
                local castPos = pos + hrp.CFrame.LookVector * 5 -- Jarak normal

                -- A: EQUIP & CAST
                inventory.Inventory_EquipRod:FireServer("BlackStar")
                fishing.CastReplication:FireServer(pos, castPos, "BlackStar", 95)
                
                -- B: TUNGGU IKAN MENGGIGIT (Biar kelihatan normal)
                task.wait(math.random(2, 4)) 
                events.ReplicateExclaim:FireServer("Common")
                
                -- C: TARIK 1 IKAN ACAK
                local target = SecretFish[math.random(1, #SecretFish)]
                events.FishGiver:FireServer({
                    hookPosition = castPos,
                    name = target.name,
                    rarity = "Rahasia",
                    weight = math.random(target.weight[1], target.weight[2])
                })
                print("DARKAI: Berhasil dapet " .. target.name)

                -- D: RESET
                fishing.CleanupCast:FireServer()
                task.wait(1.5) -- Jeda sebelum lemparan berikutnya
            end)
            task.wait(0.5)
        end
    end)
end

