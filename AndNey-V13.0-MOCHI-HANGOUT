-- 3. LOGIC REVISED
local function startFishing()
    task.spawn(function()
        while _G.AutoFish do
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                local pos = hrp.Position
                local castPos = pos + hrp.CFrame.LookVector * 5

                -- A: EQUIP & CAST
                pcall(function()
                    inventory:WaitForChild("Inventory_EquipRod"):FireServer("BlackStar")
                    fishing:WaitForChild("CastReplication"):FireServer(pos, castPos, "BlackStar", 95)
                end)
                
                -- B: WAIT BITE
                task.wait(math.random(2, 3)) 
                pcall(function() events:WaitForChild("ReplicateExclaim"):FireServer("Common") end)
                
                -- C: INJECT (FIXED FORMAT)
                task.wait(0.2)
                local target = SecretFish[math.random(1, #SecretFish)]
                
                pcall(function()
                    -- Pakai GetService biar lebih aman manggil FishGiver-nya
                    fishing:WaitForChild("FishingSystemEvents"):WaitForChild("FishGiver"):FireServer({
                        {
                            hookPosition = castPos,
                            name = target.name,
                            rarity = "Rahasia",
                            weight = math.random(target.weight[1], target.weight[2])
                        }
                    })
                end)
                
                -- D: RESET
                pcall(function() fishing:WaitForChild("CleanupCast"):FireServer() end)
                task.wait(1.5)
            else
                task.wait(1)
            end
        end
    end)
end

